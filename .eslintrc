{
  "extends": ["eslint:recommended", "prettier"],
  "ignorePatterns": [
    "3p/",
    "assets/",
    "node_modules/",
    "unpackaged/",
    "*.md",
    "LICENSE",
    "package.json",
    "sfdx-project.json"
  ],
  "overrides": [
    {
      "files": ["scripts/**/*.mjs"],
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ]
}
