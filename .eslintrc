{
  "extends": [
    "eslint:recommended",
    "@salesforce/eslint-config-lwc/recommended",
    "@salesforce/eslint-config-lwc/i18n",
    "@locker/eslint-config-locker/recommended",
    "prettier"
  ],
  "ignorePatterns": [
    "3p/",
    "node_modules/",
    "unpackaged/staticresources/",
    "*.md",
    "LICENSE",
    "package.json",
    "sfdx-project.json"
  ]
}
