{
  "name": "trailhead",
  "version": "1.0.0",
  "description": "Source code for Brett Barlow's Trailhead challenges.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebrettbarlow/trailhead.git"
  },
  "homepage": "https://github.com/thebrettbarlow/trailhead#readme",
  "bugs": {
    "url": "https://github.com/thebrettbarlow/trailhead/issues"
  },
  "scripts": {
    "dev": "./scripts/start-development.sh project-name--scratch Example",
    "format": "prettier --write . && eslint --no-error-on-unmatched-pattern . --fix",
    "format:all": "run-p format:css format:js format:prettier",
    "format:css": "stylelint '**/*.css' --allow-empty-input --cache --fix",
    "format:js": "eslint . --no-error-on-unmatched-pattern --cache --fix",
    "format:prettier": "prettier --write --cache .",
    "lint": "prettier --check . && eslint --no-error-on-unmatched-pattern .",
    "lint:all": "run-p lint:code-analyzer lint:css lint:js lint:prettier",
    "lint:code-analyzer": "./scripts/run-code-analyzer.sh --mode lint",
    "lint:code-analyzer:save": "./scripts/run-code-analyzer.sh --mode save",
    "lint:css": "stylelint '**/*.css' --allow-empty-input --cache",
    "lint:js": "eslint . --no-error-on-unmatched-pattern --cache",
    "lint:prettier": "prettier --check --cache .",
    "prepare": "husky",
    "sf:3p:deploy": "./scripts/deploy-manifest.sh scratch project-name--scratch 3p",
    "sf:3p:install": "./scripts/install-packages.sh project-name--scratch 3p",
    "sf:3p:retrieve": "./scripts/retrieve-manifest.sh project-name--scratch 3p",
    "sf:3p:verify": "./scripts/verify-manifest.sh scratch project-name--scratch 3p",
    "sf:auth": "./scripts/connect-to-org.sh trailhead",
    "sf:common:deploy": "./scripts/deploy-manifest.sh scratch project-name--scratch common",
    "sf:common:retrieve": "./scripts/retrieve-manifest.sh project-name--scratch common",
    "sf:common:verify": "./scripts/verify-manifest.sh scratch project-name--scratch common",
    "sf:create:scratch": "./scripts/create-scratch-org.sh trailhead--scratch",
    "sf:install:3p:packages": "./scripts/install-packages.sh trailhead 3p",
    "sf:module:example:deploy": "./scripts/deploy-manifest.sh scratch project-name--scratch force-app/example",
    "sf:module:example:retrieve": "./scripts/retrieve-manifest.sh project-name--scratch force-app/example",
    "sf:module:example:verify": "./scripts/verify-manifest.sh scratch project-name--scratch force-app/example",
    "sf:module:websites:deploy": "./scripts/deploy-manifest.sh scratch project-name--scratch websites && ./scripts/publish-websites.sh project-name--scratch",
    "sf:module:websites:retrieve": "./scripts/retrieve-manifest.sh project-name--scratch websites && node scripts/retrieve-websites.mjs project-name--scratch",
    "sf:module:websites:verify": "./scripts/verify-manifest.sh scratch project-name--scratch websites",
    "sf:open": "sf org open --path=lightning",
    "sf:open:setup": "sf org open --path=lightning/setup/SetupOneHome/home",
    "sf:password:create": "sf org generate password",
    "sf:password:get": "sf org display user",
    "sf:trail:dev:beginner:data:export": "./scripts/export-data.sh trailhead dev/beginner",
    "sf:trail:dev:beginner:data:import": "./scripts/import-data.sh trailhead dev/beginner",
    "sf:trail:dev:beginner:deploy": "./scripts/deploy-manifest.sh trailhead dev/beginner",
    "sf:trail:dev:beginner:install:packages": "./scripts/install-packages.sh trailhead force-app/dev/beginner",
    "sf:trail:dev:beginner:manifest": "./scripts/update-manifest.sh dev/beginner",
    "sf:trail:dev:beginner:retrieve": "./scripts/retrieve-manifest.sh trailhead dev/beginner",
    "sf:trail:dev:beginner:test:list": "./scripts/apex-test-operator.sh trailhead dev/beginner list",
    "sf:trail:dev:beginner:test:run": "./scripts/apex-test-operator.sh trailhead dev/beginner run",
    "sf:update:all": "run-s sf:update:manifest sf:update:test-class-lists",
    "sf:update:manifest": "node scripts/update-manifests.mjs",
    "sf:update:test-class-lists": "node scripts/update-test-class-lists.mjs project-name--scratch",
    "test": "./scripts/run-tests.sh trailhead"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@locker/eslint-config-locker": "^0.21.6",
    "@lwc/eslint-plugin-lwc": "^2.0.0",
    "@oclif/core": "^3.26.4",
    "@prettier/plugin-xml": "^3.2.2",
    "@salesforce-ux/stylelint-plugin-slds": "^0.1.6",
    "@salesforce/core": "^8.8.2",
    "@salesforce/dev-config": "^4.1.0",
    "@salesforce/eslint-config-lwc": "^3.7.0",
    "@salesforce/eslint-plugin-aura": "^2.1.0",
    "@salesforce/eslint-plugin-lightning": "^1.0.0",
    "@salesforce/sfdx-lwc-jest": "^3.1.0",
    "ajv": "^8.12.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.5.0",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "npm-run-all": "^4.1.5",
    "p-limit": "^6.2.0",
    "prettier": "^3.1.1",
    "prettier-plugin-apex": "^2.0.1",
    "prettier-plugin-pkg": "^0.18.0",
    "prettier-plugin-sh": "^0.13.1",
    "prettier-plugin-sql": "^0.18.1",
    "stylelint": "^16.18.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-prettier": "^5.0.3",
    "xml2js": "^0.6.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "**/*.{js,mjs}": "eslint --no-error-on-unmatched-pattern --fix",
    "*.css": "stylelint --allow-empty-input --fix",
    "*": "prettier --write"
  }
}
