{
  "plugins": [
    "prettier-plugin-apex",
    "@prettier/plugin-xml",
    "prettier-plugin-sh",
    "prettier-plugin-pkg",
    "prettier-plugin-sql"
  ],
  "apexInsertFinalNewline": false,
  "singleQuote": true,
  "trailingComma": "none",
  "overrides": [
    {
      "files": "*.{cls,trigger}",
      "options": { "printWidth": 100 }
    },
    {
      "files": "**/lwc/**/*.html",
      "options": { "parser": "lwc" }
    },
    {
      "files": "*.{cmp,page,component,design,evt}",
      "options": { "parser": "html" }
    },
    {
      "files": "*.xml",
      "options": {
        "tabWidth": 4,
        "trailingComma": "none",
        "bracketSameLine": true,
        "xmlSortAttributesByKey": true,
        "xmlWhitespaceSensitivity": "preserve"
      }
    },
    {
      "files": "**/{3p,common,force-app,post-deploy,unpackaged}/**/*.xml",
      "options": {
        "printWidth": 1000000
      }
    },
    {
      "files": "*.soql",
      "options": {
        "parser": "sql"
      }
    },
    {
      "files": "*.md",
      "options": {
        "proseWrap": "always"
      }
    },
    {
      "files": ".eslintrc",
      "options": {
        "parser": "json"
      }
    },
    {
      "files": ".husky/**/*",
      "options": {
        "parser": "sh"
      }
    },
    {
      "files": ["LICENSE"],
      "options": {
        "parser": "markdown",
        "proseWrap": "always"
      }
    }
  ]
}
